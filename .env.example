# ==============================================================================
# PRODUSAL WEB - Variables de Entorno de Ejemplo
# Copia este archivo a `.env.local` y define los valores correspondientes
# ==============================================================================

# Configuración del Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configuración de Servidor SMTP (Nodemailer - Formulario de Contacto)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@gmail.com
# Contraseña de aplicación de Google, no la contraseña normal de Gmail
SMTP_PASS=tu_password_de_aplicacion

# Opcional: si queda vacío, usa "Produsal Web" y la dirección SMTP_USER
# Si se define, la dirección remitente debe coincidir con la cuenta Gmail
CONTACT_FROM_EMAIL=
# Destinatario de las solicitudes; no requiere sus credenciales SMTP
CONTACT_TO_EMAIL=infoprodusal@grupomimesa.com
