# ==============================================================================
# PRODUSAL WEB - Variables de Entorno de Ejemplo
# Copia este archivo a `.env.local` y define los valores correspondientes
# ==============================================================================

# Configuración del Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configuración de Servidor SMTP (Nodemailer - Formulario de Contacto)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@produsal.com
SMTP_PASS=tu_password_o_app_password

# Destinatario de los correos enviados desde el formulario
CONTACT_FROM_EMAIL="Produsal Web <no-reply@produsal.com>"
CONTACT_TO_EMAIL=infoprodusal@grupomimesa.com
